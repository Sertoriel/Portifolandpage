{
  "rewrites": [
    {
      "source": "/projeto/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Qq]uora|[Pp]interest|[Ss]lackbot|[Dd]iscordbot|[Tt]elegram[Bb]ot|[Gg]ooglebot|[Bb]ingbot).*"
        }
      ],
      "destination": "/api/og-injector?type=projeto&id=:id"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Qq]uora|[Pp]interest|[Ss]lackbot|[Dd]iscordbot|[Tt]elegram[Bb]ot|[Gg]ooglebot|[Bb]ingbot).*"
        }
      ],
      "destination": "/api/og-injector?type=blog&slug=:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Qq]uora|[Pp]interest|[Ss]lackbot|[Dd]iscordbot|[Tt]elegram[Bb]ot|[Gg]ooglebot|[Bb]ingbot).*"
        }
      ],
      "destination": "/api/og-injector?type=home"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Qq]uora|[Pp]interest|[Ss]lackbot|[Dd]iscordbot|[Tt]elegram[Bb]ot|[Gg]ooglebot|[Bb]ingbot).*"
        }
      ],
      "destination": "/api/og-injector?type=blog-list"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/og-injector.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
